<Keyboard
    xmlns:latin="http://schemas.android.com/apk/res-auto"
    latin:keyWidth="20%p"
    latin:rowHeight="33.333%p"
    latin:touchPositionCorrectionData="@array/touch_position_correction_data_default">
    <include
        latin:keyboardLayout="@xml/key_styles_common" />
    <include
        latin:keyboardLayout="@xml/key_styles_number" />
    <Row>
        <Key
            latin:keySpec="0"
            latin:keyHintLabel="Q"
            latin:keyStyle="numKeyStyle" />
        <Key
            latin:keySpec="1"
            latin:keyHintLabel="W"
            latin:keyStyle="numKeyStyle" />
        <Key
            latin:keySpec="2"
            latin:keyHintLabel="E"
            latin:keyStyle="numKeyStyle" />
        <Key
            latin:keySpec="3"
            latin:keyHintLabel="R"
            latin:keyStyle="numKeyStyle" />
        <switch>
            <case
                latin:mode="date|datetime">
                <Key
                    latin:keySpec="/"
                    latin:keyStyle="numKeyStyle"
                    latin:backgroundType="functional" />
            </case>
            <case
                latin:mode="time">
                <Spacer />
            </case>
            <default>
                <Key
                    latin:keySpec=","
                    latin:keyStyle="numKeyStyle"
                    latin:backgroundType="functional" />
            </default>
        </switch>
    </Row>
    <Row>
        <Key
            latin:keySpec="+"
            latin:keyHintLabel="A"
            latin:keyStyle="numKeyStyle"
            latin:backgroundType="functional" />
        <Key
            latin:keySpec="4"
            latin:keyHintLabel="S"
            latin:keyStyle="numKeyStyle" />
        <Key
            latin:keySpec="5"
            latin:keyHintLabel="D"
            latin:keyStyle="numKeyStyle" />
        <Key
            latin:keySpec="6"
            latin:keyHintLabel="F"
            latin:keyStyle="numKeyStyle" />
        <switch>
            <case
                latin:mode="time|datetime">
                <Key
                    latin:keySpec=":"
                    latin:keyStyle="numKeyStyle"
                    latin:backgroundType="functional" />
            </case>
            <case
                latin:mode="date">
                <Spacer />
            </case>
            <default>
                <Key
                    latin:keySpec="."
                    latin:keyStyle="numKeyStyle"
                    latin:backgroundType="functional" />
            </default>
        </switch>
    </Row>
    <Row>
        <Key
            latin:keySpec="-"
            latin:keyHintLabel="Z"
            latin:keyStyle="numKeyStyle"
            latin:backgroundType="functional" />
        <Key
            latin:keySpec="7"
            latin:keyHintLabel="X"
            latin:keyStyle="numKeyStyle" />
        <Key
            latin:keySpec="8"
            latin:keyHintLabel="C"
            latin:keyStyle="numKeyStyle" />
        <Key
            latin:keySpec="9"
            latin:keyHintLabel="V"
            latin:keyStyle="numKeyStyle" />
        <switch>
            <case
                latin:mode="date|time|datetime">
                <Key
                    latin:keySpec="."
                    latin:keyStyle="numKeyStyle"
                    latin:backgroundType="functional" />
            </case>
            <default>
                <Key
                    latin:keyStyle="deleteKeyStyle" />
            </default>
        </switch>
    </Row>
</Keyboard>
