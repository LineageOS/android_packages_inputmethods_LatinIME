<merge xmlns:latin="http://schemas.android.com/apk/res/com.android.inputmethod.latin">
    <switch>
        <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
            <!-- U+1041: "၁" MYANMAR DIGIT ONE -->
            <Key latin:additionalMoreKeys="1" latin:keyHintLabel="1" latin:keySpec="&#x1041;"/>
            <!-- U+1042: "၂" MYANMAR DIGIT TWO -->
            <Key latin:additionalMoreKeys="2" latin:keyHintLabel="2" latin:keySpec="&#x1042;"/>
            <!-- U+1043: "၃" MYANMAR DIGIT THREE -->
            <Key latin:additionalMoreKeys="3" latin:keyHintLabel="3" latin:keySpec="&#x1043;"/>
            <!-- U+1044: "၄" MYANMAR DIGIT FOUR -->
            <Key latin:additionalMoreKeys="4" latin:keyHintLabel="4" latin:keySpec="&#x1044;"/>
            <!-- U+1045: "၅" MYANMAR DIGIT FIVE -->
            <Key latin:additionalMoreKeys="5" latin:keyHintLabel="5" latin:keySpec="&#x1045;"/>
            <!-- U+1046: "၆" MYANMAR DIGIT SIX -->
            <Key latin:additionalMoreKeys="6" latin:keyHintLabel="6" latin:keySpec="&#x1046;"/>
            <!-- U+1047: "၇" MYANMAR DIGIT SEVEN -->
            <Key latin:additionalMoreKeys="7" latin:keyHintLabel="7" latin:keySpec="&#x1047;"/>
            <!-- U+1048: "၈" MYANMAR DIGIT EIGHT -->
            <Key latin:additionalMoreKeys="8" latin:keyHintLabel="8" latin:keySpec="&#x1048;"/>
            <!-- U+1049: "၉" MYANMAR DIGIT NINE -->
            <Key latin:additionalMoreKeys="9" latin:keyHintLabel="9" latin:keySpec="&#x1049;"/>
            <!-- U+1040: "၀" MYANMAR DIGIT ZERO -->
            <Key latin:additionalMoreKeys="0" latin:keyHintLabel="0" latin:keySpec="&#x1040;"/>
        </case>
        <default>
            <!-- U+1008: "ဈ" MYANMAR LETTER JHA -->
            <Key latin:additionalMoreKeys="1" latin:keyHintLabel="1" latin:keySpec="&#x1008;"/>
            <!-- U+101D: "ဝ" MYANMAR LETTER VA -->
            <Key latin:additionalMoreKeys="2" latin:keyHintLabel="2" latin:keySpec="&#x101D;"/>
            <!-- U+100B: "ဋ" MYANMAR LETTER TTA -->
            <Key latin:additionalMoreKeys="3" latin:keyHintLabel="3" latin:keySpec="&#x100B;"/>
            <!-- U+102F U+1036: "ုံ" MYANMAR VOWEL SIGN U + MYANMAR SIGN ANUSVARA -->
            <Key latin:additionalMoreKeys="4" latin:keyHintLabel="4" latin:keySpec="&#x102F;&#x1036;"/>
            <!-- U+1031 U+102C: "ော" MYANMAR VOWEL SIGN E + MYANMAR VOWEL SIGN AA -->
            <Key latin:additionalMoreKeys="5" latin:keyHintLabel="5" latin:keySpec="&#x1031;&#x102C;"/>
            <!-- U+102A: "ဩ" MYANMAR LETTER AU -->
            <Key latin:additionalMoreKeys="6" latin:keyHintLabel="6" latin:keyLetterSize="30%p" latin:keySpec="&#x102A;"/>
            <!-- U+101B: "ရ" MYANMAR LETTER RA -->
            <Key latin:additionalMoreKeys="7" latin:keyHintLabel="7" latin:keySpec="&#x101B;"/>
            <!-- U+1002: "ဂ" MYANMAR LETTER Ga -->
            <Key latin:additionalMoreKeys="8" latin:keyHintLabel="8" latin:keySpec="&#x1002;"/>
            <!-- U+101F: "ဟ" MYANMAR LETTER HA -->
            <Key latin:additionalMoreKeys="9" latin:keyHintLabel="9" latin:keySpec="&#x101F;"/>
            <!-- U+104F: "၏" MYANMAR SYMBOL GENITIVE -->
            <Key latin:additionalMoreKeys="0" latin:keyHintLabel="0" latin:keySpec="&#x104F;"/>
        </default>
    </switch>
</merge>