<Keyboard
    xmlns:latin="http://schemas.android.com/apk/res-auto"
    latin:keyWidth="10%p"
    latin:rowHeight="100%p">
    <include
        latin:keyboardLayout="@xml/key_styles_common" />
    <switch>
        <case
            latin:passwordInput="true">
            <Row
                latin:rowHeight="50%p">
                <include
                    latin:keyboardLayout="@xml/rowkeys_hardware_keyboard_numbers" />
            </Row>
            <Row
                latin:rowHeight="50%p">
                <include
                    latin:keyboardLayout="@xml/rowkeys_hardware_keyboard_bar" />
            </Row>
        </case>
        <default>
            <Row>
                <include
                    latin:keyboardLayout="@xml/rowkeys_hardware_keyboard_bar" />
            </Row>
        </default>
    </switch>
</Keyboard>
