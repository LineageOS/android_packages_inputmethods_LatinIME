<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case
            latin:mode="url">
            <Key
                latin:keySpec="_" />
            <Key
                latin:keySpec="-" />
            <Key
                latin:keySpec=":"
                latin:moreKeys="!text/keyspec_symbols_semicolon" />
            <Key
                latin:keySpec="/" />
            <Key
                latin:keySpec="!text/keyspec_symbols_question"
                latin:moreKeys="!text/morekeys_question" />
        </case>
        <case
            latin:mode="email">
            <Key
                latin:keySpec="_" />
            <Key
                latin:keySpec="-" />
            <Key
                latin:keySpec="+" />
            <Key
                latin:keySpec="\@" />
            <Key
                latin:keySpec="\#" />
        </case>
        <default>
            <Key
                latin:keySpec="!text/keyspec_comma" />
            <Key
                latin:keySpec="\'"
                latin:moreKeys="!text/morekeys_single_quote" />
            <Key
                latin:keySpec=":"
                latin:moreKeys="!text/keyspec_symbols_semicolon" />
            <Key
                latin:keySpec="!"
                latin:moreKeys="!text/morekeys_exclamation" />
            <Key
                latin:keySpec="!text/keyspec_symbols_question"
                latin:moreKeys="!text/morekeys_question" />
        </default>
    </switch>
    <Key
        latin:keySpec="!text/keyspec_period"
        latin:moreKeys="!text/morekeys_punctuation" />
</merge>
