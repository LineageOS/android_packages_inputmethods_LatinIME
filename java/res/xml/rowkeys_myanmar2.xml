<merge xmlns:latin="http://schemas.android.com/apk/res/com.android.inputmethod.latin">
    <switch>
        <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
            <!-- U+100D: "ဍ" MYANMAR LETTER TTA -->
            <Key latin:keySpec="&#x100D;"/>
            <!-- U+100F U+1039 U+100D: "ဏ္ဍ" MYANMAR LETTER NNA + MYANMAR SIGN VIRAMA + MYANMAR LETTER TTA -->
            <Key latin:keySpec="&#x100F;&#x1039;&#x100D;"/>
            <!-- U+1023: "ဣ" MYANMAR LETTER I -->
            <Key latin:keySpec="&#x1023;"/>
            <!-- U+104E U+1004 U+103A U+1038: "၎င်း" MYANMAR SYMBOL AFOREMENTIONED -->
            <Key latin:keySpec="&#x104E;&#x1004;&#x103A;&#x1038;"/>
            <!-- U+1024: "ဤ" MYANMAR LETTER II -->
            <Key latin:keySpec="&#x1024;"/>
            <!-- U+104C: "၌" MYANMAR SYMBOL LOCATIVE -->
            <Key latin:keySpec="&#x104C;"/>
            <!-- U+1025: "ဥ" MYANMAR LETTER U -->
            <Key latin:keySpec="&#x1025;"/>
            <!-- U+104D: "၍" MYANMAR SYMBOL COMPLETED -->
            <Key latin:keySpec="&#x104D;"/>
            <!-- U+103F: "ဿ" MYANMAR LETTER GREAT SA -->
            <Key latin:keySpec="&#x103F;"/>
            <!-- U+100F: "ဏ" MYANMAR LETTER NNA -->
            <Key latin:keySpec="&#x100F;"/>
        </case>
        <default>
            <!-- U+1006: "ဆ" MYANMAR LETTER SA -->
            <Key latin:additionalMoreKeys="&#x100D;,5" latin:keySpec="&#x1006;"/>
            <!-- U+1010: "တ" MYANMAR LETTER TA -->
            <Key latin:additionalMoreKeys="&#x100F;&#x1039;&#x100D;" latin:keySpec="&#x1010;"/>
            <!-- U+1014: "န" MYANMAR LETTER NA -->
            <Key latin:additionalMoreKeys="&#x1023;" latin:keySpec="&#x1014;"/>
            <!-- U+1019: "မ" MYANMAR LETTER MA -->
            <Key latin:additionalMoreKeys="&#x104E;&#x1004;&#x103A;&#x1038;" latin:keySpec="&#x1019;"/>
            <!-- U+1021: "အ" MYANMAR LETTER A -->
            <Key latin:additionalMoreKeys="&#x1024;" latin:keySpec="&#x1021;"/>
            <!-- U+1015: "ပ" MYANMAR LETTER PA -->
            <Key latin:additionalMoreKeys="&#x104C;" latin:keySpec="&#x1015;"/>
            <!-- U+1000: "က" MYANMAR LETTER KA -->
            <Key latin:additionalMoreKeys="&#x1025;" latin:keySpec="&#x1000;"/>
            <!-- U+1004: "င" MYANMAR LETTER NGA -->
            <Key latin:additionalMoreKeys="&#x104D;" latin:keySpec="&#x1004;"/>
            <!-- U+101E: "သ" MYANMAR LETTER THA -->
            <Key latin:additionalMoreKeys="&#x103F;" latin:keySpec="&#x101E;"/>
            <!-- U+1005: "စ" MYANMAR LETTER CA -->
            <Key latin:additionalMoreKeys="&#x100F;" latin:keySpec="&#x1005;"/>
        </default>
    </switch>
</merge>