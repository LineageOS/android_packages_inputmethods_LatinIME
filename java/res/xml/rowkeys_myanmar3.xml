<merge xmlns:latin="http://schemas.android.com/apk/res/com.android.inputmethod.latin">
    <switch>
        <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
            <!-- U+1017: "ဗ" MYANMAR LETTER BA -->
            <Key latin:keySpec="&#x1017;"/>
            <!-- U+103E: "ှ" MYANMAR SIGN MEDIAL HA -->
            <Key latin:keySpec="&#x103E;"/>
            <!-- U+102E: "ီ" MYANMAR VOWEL SIGN II -->
            <Key latin:keySpec="&#x102E;"/>
            <!-- U+1039: "္" MYANMAR SIGN VIRAMA -->
            <Key latin:keySpec="&#x1039;"/>
            <!-- U+103D: "ွ" MYANMAR SIGN MEDIAL WA -->
            <Key latin:keySpec="&#x103D;"/>
            <!-- U+1036: "ံ" MYANMAR SIGN ANUSVARA -->
            <Key latin:keySpec="&#x1036;"/>
            <!-- U+1032: "ဲ" MYANMAR VOWEL SIGN AI -->
            <Key latin:keySpec="&#x1032;"/>
            <!-- U+1012: "ဒ" MYANMAR LETTER DA -->
            <Key latin:keySpec="&#x1012;"/>
            <!-- U+1013: "ဓ" MYANMAR LETTER DHA -->
            <Key latin:keySpec="&#x1013;"/>
            <!-- U+100F U+1039 U+100C: "ဏ္ဍ" MYANMAR LETTER NNA + MYANMAR SIGN VIRAMA + MYANMAR LETTER TTHA -->
            <Key latin:keySpec="&#x100F;&#x1039;&#x100C;"/>
        </case>
        <default>
            <!-- U+1031: "ေ" MYANMAR VOWEL SIGN E -->
            <Key latin:additionalMoreKeys="&#x1017;" latin:keySpec="&#x1031;"/>
            <!-- U+103B: "ျ" MYANMAR SIGN MEDIAL YA -->
            <Key latin:additionalMoreKeys="&#x103E;" latin:keySpec="&#x103B;"/>
            <!-- U+102D: "ိ" MYANMAR VOWEL SIGN I -->
            <Key latin:additionalMoreKeys="&#x102E;" latin:keySpec="&#x102D;"/>
            <!-- U+103A: "်" MYANMAR SIGN ASAT -->
            <Key latin:additionalMoreKeys="&#x1039;" latin:keySpec="&#x103A;"/>
            <!-- U+102B: "ါ" MYANMAR VOWEL SIGN TALL AA -->
            <Key latin:additionalMoreKeys="&#x103D;" latin:keySpec="&#x102B;"/>
            <!-- U+1037: "့" MYANMAR SIGN DOT BELOW -->
            <Key latin:additionalMoreKeys="&#x1036;" latin:keySpec="&#x1037;"/>
            <!-- U+103C: "ြ" MYANMAR SIGN MEDIAL RA -->
            <Key latin:additionalMoreKeys="&#x1032;" latin:keySpec="&#x103C;"/>
            <!-- U+102F: "ု" MYANMAR VOWEL SIGN U -->
            <Key latin:additionalMoreKeys="&#x1012;" latin:keySpec="&#x102F;"/>
            <!-- U+1030: "ူ" MYANMAR VOWEL SIGN UU -->
            <Key latin:additionalMoreKeys="&#x1013;" latin:keySpec="&#x1030;"/>
            <!-- U+1038: "း" MYANMAR SIGN VISARGA -->
            <Key latin:additionalMoreKeys="&#x100F;&#x1039;&#x100C;" latin:keySpec="&#x1038;"/>
        </default>
    </switch>
</merge>